    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
