{
  "name": "supersynth",
  "version": "0.3.0",
  "description": "Real instrument sounds for Node.js: spectral resynthesis of real recordings (piano, 16 pipe organs and a harmonium, strings, winds, brass, mallets) in a native Rust engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./instruments": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js",
      "default": "./dist/catalog/index.js"
    },
    "./organs": {
      "types": "./dist/organs/index.d.ts",
      "import": "./dist/organs/index.js",
      "default": "./dist/organs/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#platform": {
      "types": "./dist/platform/node.d.ts",
      "browser": "./dist/platform/browser.js",
      "default": "./dist/platform/node.js"
    },
    "#wasm": "./wasm/supersynth.js"
  },
  "files": [
    "dist",
    "src",
    "models",
    "wasm",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "npm/*"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:native && npm run build:ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.js",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.js test/unit",
    "test:rust": "cd native && cargo test --release --workspace",
    "test:browser": "node scripts/test-browser.mjs",
    "bench": "node --import tsx bench/engine.bench.ts",
    "live-test": "node --import tsx bench/live.ts",
    "bench:organs": "node --import tsx bench/organs.bench.ts",
    "load-test": "node --import tsx bench/load.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "example:tour": "node --import tsx examples/tour.ts",
    "example:piano": "node --import tsx examples/piano.ts",
    "example:organ": "node --import tsx examples/organ.ts",
    "example:orchestra": "node --import tsx examples/orchestra.ts",
    "example:midi": "node --import tsx examples/midi-file.ts examples/jsbwv532.mid",
    "example:browser": "node examples/browser/serve.mjs",
    "demos": "node --import tsx examples/render-demos.ts",
    "models": "cd tools/ssm && python build_all.py",
    "version": "node scripts/sync-versions.mjs && git add npm package-lock.json",
    "prepack": "npm run build:ts"
  },
  "keywords": [
    "additive",
    "audio",
    "dsp",
    "instruments",
    "midi",
    "native",
    "orchestra",
    "organ",
    "piano",
    "pipe-organ",
    "resynthesis",
    "rust",
    "sampler",
    "sound",
    "synth",
    "synthesis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jddubois/supersynth.git"
  },
  "homepage": "https://github.com/jddubois/supersynth#readme",
  "bugs": {
    "url": "https://github.com/jddubois/supersynth/issues"
  },
  "peerDependencies": {
    "@supersynth/organ-azzio": "*",
    "@supersynth/organ-burea": "*",
    "@supersynth/organ-cracow": "*",
    "@supersynth/organ-dluga-koscielna": "*",
    "@supersynth/organ-friesach": "*",
    "@supersynth/organ-giubiasco": "*",
    "@supersynth/organ-green-positiv": "*",
    "@supersynth/organ-harmonium": "*",
    "@supersynth/organ-ledziny": "*",
    "@supersynth/organ-lipiny": "*",
    "@supersynth/organ-melcer": "*",
    "@supersynth/organ-raszczyce": "*",
    "@supersynth/organ-saint-jean-de-luz": "*",
    "@supersynth/organ-skrzatusz": "*",
    "@supersynth/organ-strassburg": "*",
    "@supersynth/organ-szczecinek": "*"
  },
  "peerDependenciesMeta": {
    "@supersynth/organ-burea": {
      "optional": true
    },
    "@supersynth/organ-azzio": {
      "optional": true
    },
    "@supersynth/organ-cracow": {
      "optional": true
    },
    "@supersynth/organ-dluga-koscielna": {
      "optional": true
    },
    "@supersynth/organ-friesach": {
      "optional": true
    },
    "@supersynth/organ-giubiasco": {
      "optional": true
    },
    "@supersynth/organ-green-positiv": {
      "optional": true
    },
    "@supersynth/organ-harmonium": {
      "optional": true
    },
    "@supersynth/organ-ledziny": {
      "optional": true
    },
    "@supersynth/organ-lipiny": {
      "optional": true
    },
    "@supersynth/organ-melcer": {
      "optional": true
    },
    "@supersynth/organ-raszczyce": {
      "optional": true
    },
    "@supersynth/organ-saint-jean-de-luz": {
      "optional": true
    },
    "@supersynth/organ-skrzatusz": {
      "optional": true
    },
    "@supersynth/organ-strassburg": {
      "optional": true
    },
    "@supersynth/organ-szczecinek": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@supersynth/darwin-arm64": "0.3.0",
    "@supersynth/darwin-x64": "0.3.0",
    "@supersynth/linux-arm64-gnu": "0.3.0",
    "@supersynth/linux-x64-gnu": "0.3.0",
    "@supersynth/linux-x64-musl": "0.3.0",
    "@supersynth/win32-x64-msvc": "0.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "playwright-core": "^1.56.1",
    "ts-jest": "^29.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
