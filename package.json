{
  "name": "supersynth",
  "version": "0.2.0",
  "description": "Real instrument sounds for Node.js: spectral resynthesis of real recordings (piano, 16 pipe organs and a harmonium, strings, winds, brass, mallets) in a native Rust engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./instruments": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./organs": {
      "types": "./dist/organs/index.d.ts",
      "import": "./dist/organs/index.js"
    }
  },
  "files": [
    "dist",
    "models",
    "supersynth.node",
    "supersynth.*.node",
    "NOTICE.md"
  ],
  "workspaces": [
    "packages/*",
    "npm/*"
  ],
  "scripts": {
    "build:native": "cd native && cargo build --release -p supersynth-native && (cp target/release/libsupersynth_native.dylib ../supersynth.node 2>/dev/null || cp target/release/libsupersynth_native.so ../supersynth.node)",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:native && npm run build:ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.js",
    "test:rust": "cd native && cargo test --release --workspace",
    "bench": "node --import tsx bench/engine.bench.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example:tour": "node --import tsx examples/tour.ts",
    "example:piano": "node --import tsx examples/piano.ts",
    "example:organ": "node --import tsx examples/organ.ts",
    "example:orchestra": "node --import tsx examples/orchestra.ts",
    "example:midi": "node --import tsx examples/midi-file.ts examples/jsbwv532.mid",
    "demos": "node --import tsx examples/render-demos.ts",
    "models": "cd tools/ssm && python build_all.py"
  },
  "keywords": [
    "additive",
    "audio",
    "dsp",
    "instruments",
    "midi",
    "native",
    "orchestra",
    "organ",
    "piano",
    "pipe-organ",
    "resynthesis",
    "rust",
    "sampler",
    "sound",
    "synth",
    "synthesis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jddubois/supersynth.git"
  },
  "homepage": "https://github.com/jddubois/supersynth#readme",
  "bugs": {
    "url": "https://github.com/jddubois/supersynth/issues"
  },
  "peerDependencies": {
    "supersynth-organ-burea": "*",
    "supersynth-organ-azzio": "*",
    "supersynth-organ-cracow": "*",
    "supersynth-organ-dluga-koscielna": "*",
    "supersynth-organ-friesach": "*",
    "supersynth-organ-giubiasco": "*",
    "supersynth-organ-green-positiv": "*",
    "supersynth-organ-harmonium": "*",
    "supersynth-organ-ledziny": "*",
    "supersynth-organ-lipiny": "*",
    "supersynth-organ-melcer": "*",
    "supersynth-organ-raszczyce": "*",
    "supersynth-organ-saint-jean-de-luz": "*",
    "supersynth-organ-skrzatusz": "*",
    "supersynth-organ-strassburg": "*",
    "supersynth-organ-szczecinek": "*"
  },
  "peerDependenciesMeta": {
    "supersynth-organ-burea": {
      "optional": true
    },
    "supersynth-organ-azzio": {
      "optional": true
    },
    "supersynth-organ-cracow": {
      "optional": true
    },
    "supersynth-organ-dluga-koscielna": {
      "optional": true
    },
    "supersynth-organ-friesach": {
      "optional": true
    },
    "supersynth-organ-giubiasco": {
      "optional": true
    },
    "supersynth-organ-green-positiv": {
      "optional": true
    },
    "supersynth-organ-harmonium": {
      "optional": true
    },
    "supersynth-organ-ledziny": {
      "optional": true
    },
    "supersynth-organ-lipiny": {
      "optional": true
    },
    "supersynth-organ-melcer": {
      "optional": true
    },
    "supersynth-organ-raszczyce": {
      "optional": true
    },
    "supersynth-organ-saint-jean-de-luz": {
      "optional": true
    },
    "supersynth-organ-skrzatusz": {
      "optional": true
    },
    "supersynth-organ-strassburg": {
      "optional": true
    },
    "supersynth-organ-szczecinek": {
